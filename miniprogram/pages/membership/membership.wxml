<view class="mp-page">
  <!-- 顶部状态卡 (红底金冠) -->
  <view class="mp-hero">
    <view class="mp-crown {{status && status.is_member ? 'on' : ''}}">✦</view>
    <view class="mp-hero-main">
      <view class="mp-hero-title">{{status && status.is_member ? '会员生效中' : '尚未开通会员'}}</view>
      <text class="mp-hero-sub" wx:if="{{status && status.is_member}}">{{status.expires_at}} 到期</text>
      <text class="mp-hero-sub" wx:else>红娘一对一撮合 · 全年资料展示</text>
    </view>
  </view>

  <!-- 会员期内: 额度快照 -->
  <view class="mp-card" wx:if="{{status && status.is_member}}">
    <view class="mp-kv"><text>今日会员额度</text><text>{{status.quota.used}} / {{status.quota.limit}} 次</text></view>
    <view class="mp-kv"><text>永久余额</text><text>{{status.quota.balance}} 次</text></view>
  </view>

  <!-- 权益说明 -->
  <view class="mp-card">
    <view class="mp-card-title">会员权益</view>
    <view class="mp-benefit"><text class="mp-dot">·</text>每日申请联系 {{memberDailyQuota}} 次（非会员每日 {{freeDailyQuota}} 次）</view>
    <view class="mp-benefit"><text class="mp-dot">·</text>红娘一对一撮合, 优先安排推荐</view>
    <view class="mp-benefit"><text class="mp-dot">·</text>全年资料展示, 不限查阅次数</view>
  </view>

  <!-- 模拟支付提示 (联调模式) -->
  <view class="mp-mock-banner" wx:if="{{payMode === 'mock'}}">当前为模拟支付模式 (联调演练), 支付不会真实扣款</view>

  <!-- 套餐购买 -->
  <view class="mp-card" wx:if="{{plans.length > 0}}">
    <view class="mp-card-title">选择套餐</view>
    <view class="mp-plan" wx:for="{{plans}}" wx:key="code">
      <view class="mp-plan-main">
        <view class="mp-plan-name">{{item.name}}</view>
        <text class="mp-plan-sub">{{item.days}} 天</text>
      </view>
      <view class="mp-plan-price"><text class="rmb">¥</text>{{item.price}}</view>
      <button class="mp-plan-btn" data-code="{{item.code}}" bindtap="onBuy"
        disabled="{{submitting}}">{{payMode === 'online' ? '立即支付' : payMode === 'mock' ? '模拟支付' : '去门店办理'}}</button>
    </view>
    <view class="mp-tip" wx:if="{{payMode !== 'off'}}">支付即表示同意
      <text class="mp-link" bindtap="goRefund">《线上报名费退费规则协议》</text>
    </view>
  </view>

  <!-- 线下办理引导 (线上开关关闭时始终展示; 开启时也给一条线下路径) -->
  <view class="mp-card">
    <view class="mp-card-title">线下办理</view>
    <view class="mp-tip">也可前往附近门店, 由红娘现场办理开通, 现场收款。</view>
    <button class="mp-store-btn" bindtap="goStore">去附近门店 ›</button>
  </view>

  <!-- 最近订单 -->
  <view class="mp-card" wx:if="{{latestOrder}}">
    <view class="mp-card-title">最近订单</view>
    <view class="mp-kv"><text>套餐</text><text>{{latestOrder.plan_name}}</text></view>
    <view class="mp-kv"><text>金额</text><text>¥ {{latestOrder.amount_fen / 100}}</text></view>
    <view class="mp-kv"><text>状态</text><text class="{{latestOrder.status === 'paid' ? 'ok' : ''}}">{{latestOrderStatusLabel}}</text></view>
  </view>

  <view class="mp-footer-tip">会员服务由当地门店与红娘提供, 有疑问请联系你的门店。</view>
</view>
