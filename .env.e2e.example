# ============================================================
# 本地 e2e 专用环境（docker compose --env-file 使用，已 gitignored）
# 基于 .env.example，改动点：隔离 SECRET、SMTP 指向 mailcatcher、
# CORS 放行本地 vite 端口、独立项目名。数据库用命名卷，不碰本机 ./data
# ============================================================

DOMAIN=localhost
FRONTEND_HOST=http://localhost:5175
ENVIRONMENT=local
TRUSTED_PROXIES=

PROJECT_NAME="乾缘婚恋 e2e"
STACK_NAME=qianyuan

BACKEND_CORS_ORIGINS="http://localhost:5175,http://127.0.0.1:5175"
SECRET_KEY=e2e-only-secret-key-openssl-rand-hex-32

FIRST_SUPERUSER=admin@qianyuan.cn
FIRST_SUPERUSER_PASSWORD=本地e2e专用改我

WECHAT_APP_ID=
WECHAT_APP_SECRET=

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

SMTP_HOST=mailcatcher-e2e
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@qianyuan.cn
SMTP_TLS=False
SMTP_SSL=False
SMTP_PORT=1025

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=qianyuan
POSTGRES_USER=qianyuan
POSTGRES_PASSWORD=本地e2e专用改我

SENTRY_DSN=

# e2e 并行用例集中登录/找回密码, 放开 IP 限流阈值 (仅本地 e2e 栈)
LOGIN_IP_MAX=500
SENSITIVE_MAX=500

DOCKER_IMAGE_BACKEND=qianyuan-backend-e2e
DOCKER_IMAGE_FRONTEND=qianyuan-admin

COMPOSE_PROJECT_NAME=qy-e2e

EMAIL=admin@qianyuan.website
USERNAME=admin
HASHED_PASSWORD=$$apr1$$e2e-placeholder

VITE_API_URL=http://localhost:18000
