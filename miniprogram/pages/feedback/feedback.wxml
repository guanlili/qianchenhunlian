<view class="page">
  <view class="header">
    <view class="title">意见反馈</view>
    <view class="sub">您的反馈是我们改进的动力 (上限 1000 字)</view>
  </view>
  <view class="form-card">
    <textarea
      class="content-area"
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="1000"
      placeholder="说说您的建议、遇到的问题..."
    />
    <view class="counter">{{content.length}}/1000</view>
  </view>
  <view class="form-card">
    <text class="label">联系方式 (选填)</text>
    <input class="contact-input" value="{{contact}}" bindinput="onContactInput" placeholder="手机号 / 微信号 (便于回复)" />
  </view>
  <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
    {{submitting ? '提交中...' : '提交反馈'}}
  </button>
  <!-- 我的反馈历史 (含官方回复) -->
  <view class="history-card" wx:if="{{historyLoaded && history.length}}">
    <view class="history-title">我的反馈</view>
    <view class="history-item" wx:for="{{history}}" wx:key="id">
      <view class="hi-head">
        <text class="hi-date">{{item.createdText}}</text>
        <text class="hi-status {{item.status === 'handled' ? 'done' : ''}}">{{item.status === 'handled' ? '已回复' : '处理中'}}</text>
      </view>
      <view class="hi-content">{{item.content}}</view>
      <view class="hi-reply" wx:if="{{item.admin_note}}">
        <text class="hi-reply-label">官方回复：</text>{{item.admin_note}}
      </view>
    </view>
  </view>
</view>
