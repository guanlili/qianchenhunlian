.page { min-height: 100vh; background: #fbf6ee; padding: 32rpx 28rpx; }
.header { padding: 16rpx 0 24rpx; }
.title { font-size: 38rpx; font-weight: 800; color: #1f1a17; }
.sub { margin-top: 8rpx; color: #9a8e84; font-size: 24rpx; }
.form-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; }
.content-area { width: 100%; min-height: 280rpx; font-size: 28rpx; color: #1f1a17; }
.counter { text-align: right; color: #9a8e84; font-size: 22rpx; margin-top: 8rpx; }
.label { display: block; color: #9a8e84; font-size: 24rpx; margin-bottom: 12rpx; }
.contact-input { font-size: 28rpx; color: #1f1a17; }
.submit-btn {
  width: 100%; min-height: 96rpx; border-radius: 999rpx;
  background: linear-gradient(90deg, #c93434, #8f1f1f);
  color: #fff; font-size: 32rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-top: 32rpx;
}

/* 我的反馈历史 */
.history-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.history-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1a17;
  margin-bottom: 16rpx;
}
.history-item {
  padding: 16rpx 0;
  border-top: 1rpx solid #f0e8dd;
}
.hi-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.hi-date { font-size: 22rpx; color: #b3a89a; }
.hi-status { font-size: 22rpx; color: #b3a89a; }
.hi-status.done { color: #1e9e5c; }
.hi-content { font-size: 26rpx; color: #1f1a17; line-height: 1.6; }
.hi-reply {
  margin-top: 10rpx;
  padding: 14rpx 18rpx;
  background: #fdf7ef;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #5a4f47;
  line-height: 1.6;
}
.hi-reply-label { color: #c93434; font-weight: 600; }
