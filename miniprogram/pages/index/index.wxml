<!-- ICP 备案 footer (各主页面底部复用) -->
<template name="icp-footer">
  <view class="home-footer">
    <text>企业名称：德州乾瑞婚恋服务有限公司</text>
    <text>统一社会信用代码：91371428MAKCPBR96B</text>
    <text>鲁ICP备2026034161号-3X</text>
  </view>
</template>

<view class="qy-page">
  <block wx:if="{{screen == 'home'}}">
    <!-- 门店会员制: 非会员先看 5 个匹配预览 (转化钩子), 完整浏览引导到店开通 -->
    <view class="member-lock" wx:if="{{apiReady && !isMember}}">
      <view class="member-lock-head">
        <view class="member-lock-crown-wrap">
          <view class="member-lock-crown">✦</view>
        </view>
        <view class="member-lock-title" wx:if="{{previewGate}}">{{guestStep === 1 ? '先做个小测试' : guestStep === 2 ? '欢迎你, 先完善基本信息' : guestStep === 3 ? '完善基本条件' : guestStep === 4 ? '更多资料 (选填)' : guestStep === 5 ? '择偶要求' : '确认缴费'}}</view>
        <view class="member-lock-title" wx:else>每日推荐</view>
        <view class="member-lock-sub" wx:if="{{previewGate}}">
          <text>{{guestStep === 1 ? '选择性别、出生年份和所在城市' : guestStep === 2 ? '上传真实头像, 填写昵称并同意协议' : guestStep === 3 ? '身高、体重、民族、婚姻、职业与月收入' : guestStep === 4 ? '学历、工作、资产等, 均为选填' : guestStep === 5 ? '告诉我们你期待什么样的另一半' : '微信支付年费, 或填体验码直接开通'}}</text>
          <text>填齐资料马上为你匹配相配的会员 (第 {{guestStep}} 步 / 共 6 步)</text>
        </view>
        <view class="member-lock-sub" wx:else>
          <text>按你的性别、年龄、城市相配而来</text>
          <text>注册会员可查看全部严选资料</text>
        </view>
      </view>

      <!-- 游客注册向导 · 第 1 步: 三问 -->
      <view class="member-lock-card" wx:if="{{previewGate && guestStep === 1}}">
        <view class="guest-row">
          <view class="guest-label">性别<text class="req">*</text></view>
          <view class="gender-chips">
            <view class="gender-chip {{guestGender === '男' ? 'on' : ''}}" bindtap="onGuestGenderTap" data-gender="男">男</view>
            <view class="gender-chip {{guestGender === '女' ? 'on' : ''}}" bindtap="onGuestGenderTap" data-gender="女">女</view>
          </view>
        </view>
        <view class="guest-row">
          <view class="guest-label">出生年份<text class="req">*</text></view>
          <picker mode="selector" range="{{guestYears}}" value="{{guestYearIndex < 0 ? 0 : guestYearIndex}}" bindchange="onGuestYearPick">
            <view class="guest-picker {{guestYearIndex < 0 ? 'placeholder' : ''}}">
              {{guestYearIndex < 0 ? '请选择出生年份' : guestYears[guestYearIndex] + ' 年'}}
            </view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">所在城市<text class="req">*</text></view>
          <picker mode="selector" range="{{guestCities}}" value="{{guestCityIndex < 0 ? 0 : guestCityIndex}}" bindchange="onGuestCityPick">
            <view class="guest-picker {{guestCityIndex < 0 ? 'placeholder' : ''}}">
              {{guestCityIndex < 0 ? (guestCities.length ? '请选择所在城市' : '城市加载失败, 点此重试') : guestCities[guestCityIndex]}}
            </view>
          </picker>
          <view wx:if="{{!guestCities.length}}" class="guest-retry" bindtap="loadGuestCities">重新加载城市列表</view>
        </view>
        <button class="member-lock-btn" bindtap="submitGuestBasics">进入每日推荐</button>
      </view>
      <!-- 注册页: 头像 + 昵称 + 协议 -->
      <view class="member-lock-card" wx:if="{{previewGate && guestStep === 2}}">
        <view class="guest-row">
          <view class="guest-label">真实头像<text class="req">*</text></view>
          <view class="guest-avatar" bindtap="onGuestAvatarPick">
            <image wx:if="{{guestAvatarPath}}" class="guest-avatar-img" src="{{guestAvatarPath}}" mode="aspectFill" />
            <view wx:else class="guest-avatar-default"><text>+</text></view>
            <text class="guest-avatar-tag">{{guestAvatarPath ? '点击更换' : '上传真实头像'}}</text>
          </view>
        </view>
        <view class="guest-row">
          <view class="guest-label">昵称<text class="req">*</text></view>
          <input class="guest-input" type="text" placeholder="请填写昵称" value="{{guestNickname}}" bindinput="onGuestNicknameInput" maxlength="20" />
        </view>
        <view class="guest-agree" bindtap="toggleGuestAgreed">
          <view class="guest-checkbox {{guestAgreed ? 'on' : ''}}">{{guestAgreed ? '✓' : ''}}</view>
          <text class="guest-agree-text">我已阅读并同意
            <text class="link" catchtap="goAgreement">《用户协议》</text>
            <text class="link" catchtap="goPrivacy">《隐私政策》</text>
            <text class="link" catchtap="goRefund">《线上报名退费协议》</text>
          </text>
        </view>
        <button class="member-lock-btn" bindtap="submitGuestRegister" disabled="{{guestSubmitting}}">
          {{guestSubmitting ? '提交中...' : '开始使用'}}
        </button>
      </view>


      <!-- 填写资料 · 基本条件 -->
      <view class="member-lock-card" wx:if="{{previewGate && guestStep === 3}}">
        <view class="guest-row">
          <view class="guest-label">身高 (cm)<text class="req">*</text></view>
          <input class="guest-input" type="number" placeholder="如 165" value="{{guestForm.height}}" bindinput="onGuestHeightInput" maxlength="3" />
        </view>
        <view class="guest-row">
          <view class="guest-label">体重 (kg)<text class="req">*</text></view>
          <input class="guest-input" type="number" placeholder="如 55" value="{{guestForm.weight}}" bindinput="onGuestNumInput" data-field="weight" maxlength="3" />
        </view>
        <view class="guest-row">
          <view class="guest-label">民族<text class="req">*</text></view>
          <picker mode="selector" range="{{ethnicityOptions}}" bindchange="onGuestFormPick" data-field="ethnicity">
            <view class="guest-picker {{!guestForm.ethnicity ? 'placeholder' : ''}}">{{guestForm.ethnicity || '请选择民族'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">婚姻状况<text class="req">*</text></view>
          <picker mode="selector" range="{{marriageOptions}}" bindchange="onGuestFormPick" data-field="marriage">
            <view class="guest-picker {{!guestForm.marriage ? 'placeholder' : ''}}">{{guestForm.marriage || '请选择婚姻状况'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">职业<text class="req">*</text></view>
          <picker mode="selector" range="{{jobOptions}}" bindchange="onGuestFormPick" data-field="job">
            <view class="guest-picker {{!guestForm.job ? 'placeholder' : ''}}">{{guestForm.job || '请选择职业'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">月收入<text class="req">*</text></view>
          <picker mode="selector" range="{{incomeOptions}}" bindchange="onGuestFormPick" data-field="income">
            <view class="guest-picker {{!guestForm.income ? 'placeholder' : ''}}">{{guestForm.income || '请选择月收入'}}</view>
          </picker>
        </view>
        <button class="member-lock-btn" bindtap="submitGuestStep2">下一步</button>
      </view>

      <!-- 填写资料 · 工作与资产 + 联系方式 -->
      <view class="member-lock-card" wx:if="{{previewGate && guestStep === 4}}">
        <view class="guest-row">
          <view class="guest-label">学历</view>
          <picker mode="selector" range="{{eduOptions}}" bindchange="onGuestFormPick" data-field="edu">
            <view class="guest-picker {{!guestForm.edu ? 'placeholder' : ''}}">{{guestForm.edu || '请选择学历'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">工作单位性质</view>
          <picker mode="selector" range="{{employerOptions}}" bindchange="onGuestFormPick" data-field="employer_type">
            <view class="guest-picker {{!guestForm.employer_type ? 'placeholder' : ''}}">{{guestForm.employer_type || '请选择'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">是否有社保</view>
          <picker mode="selector" range="{{socialOptions}}" bindchange="onGuestFormPick" data-field="has_social_insurance">
            <view class="guest-picker {{!guestForm.has_social_insurance ? 'placeholder' : ''}}">{{guestForm.has_social_insurance || '请选择'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">身体状况</view>
          <picker mode="selector" range="{{healthOptions}}" bindchange="onGuestFormPick" data-field="health_status">
            <view class="guest-picker {{!guestForm.health_status ? 'placeholder' : ''}}">{{guestForm.health_status || '请选择'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">兴趣爱好</view>
          <input class="guest-input" type="text" placeholder="如 旅行/烹饪/运动 (选填)" value="{{guestForm.hobbies}}" bindinput="onGuestTextInput" data-field="hobbies" maxlength="120" />
        </view>
        <view class="guest-row">
          <view class="guest-label">户籍地</view>
          <picker mode="selector" range="{{regions}}" bindchange="onGuestFormPick" data-field="origin">
            <view class="guest-picker {{!guestForm.origin ? 'placeholder' : ''}}">{{guestForm.origin || '请选择户籍地'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">家乡</view>
          <picker mode="selector" range="{{regions}}" bindchange="onGuestFormPick" data-field="hometown">
            <view class="guest-picker {{!guestForm.hometown ? 'placeholder' : ''}}">{{guestForm.hometown || '请选择家乡'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">体型</view>
          <picker mode="selector" range="{{bodyOptions}}" bindchange="onGuestFormPick" data-field="body_type">
            <view class="guest-picker {{!guestForm.body_type ? 'placeholder' : ''}}">{{guestForm.body_type || '请选择体型'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">是否有婚房</view>
          <picker mode="selector" range="{{houseOptions}}" bindchange="onGuestFormPick" data-field="has_house">
            <view class="guest-picker {{!guestForm.has_house ? 'placeholder' : ''}}">{{guestForm.has_house || '请选择婚房情况'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">是否有车</view>
          <picker mode="selector" range="{{carOptions}}" bindchange="onGuestFormPick" data-field="has_car">
            <view class="guest-picker {{!guestForm.has_car ? 'placeholder' : ''}}">{{guestForm.has_car || '请选择'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">自我介绍 (选填)</view>
          <textarea class="guest-textarea" placeholder="介绍一下自己, 让会员更了解你" value="{{guestForm.desc}}" bindinput="onGuestDescInput" maxlength="200" auto-height />
        </view>
        <view class="guest-row">
          <view class="guest-label">手机号</view>
          <input class="guest-input" type="number" placeholder="红娘联系你撮合用" value="{{guestForm.phone}}" bindinput="onGuestContactInput" data-field="phone" maxlength="11" />
        </view>
        <view class="guest-row">
          <view class="guest-label">微信号</view>
          <input class="guest-input" type="text" placeholder="填微信号即可" value="{{guestForm.wechat}}" bindinput="onGuestContactInput" data-field="wechat" maxlength="32" />
        </view>
        <button class="member-lock-btn" bindtap="submitGuestStep3">下一步</button>
      </view>

      <!-- 择偶要求 (必填: 年份/身高/月收入/居住要求) -->
      <view class="member-lock-card" wx:if="{{previewGate && guestStep === 5}}">
        <view class="guest-row">
          <view class="guest-label">对方出生年份<text class="req">*</text></view>
          <view class="criteria-range">
            <picker mode="selector" range="{{guestYears}}" bindchange="onGuestFormPick" data-field="cYearMin">
              <view class="guest-picker {{!guestForm.cYearMin ? 'placeholder' : ''}}">{{guestForm.cYearMin || '起始'}}</view>
            </picker>
            <text class="range-sep">至</text>
            <picker mode="selector" range="{{guestYears}}" bindchange="onGuestFormPick" data-field="cYearMax">
              <view class="guest-picker {{!guestForm.cYearMax ? 'placeholder' : ''}}">{{guestForm.cYearMax || '截止'}}</view>
            </picker>
          </view>
        </view>
        <view class="guest-row">
          <view class="guest-label">对方身高 (cm)<text class="req">*</text></view>
          <view class="criteria-range">
            <input class="guest-input" type="number" placeholder="下限" value="{{guestForm.cHeightMin}}" bindinput="onGuestNumInput" data-field="cHeightMin" maxlength="3" />
            <text class="range-sep">至</text>
            <input class="guest-input" type="number" placeholder="上限" value="{{guestForm.cHeightMax}}" bindinput="onGuestNumInput" data-field="cHeightMax" maxlength="3" />
          </view>
        </view>
        <view class="guest-row">
          <view class="guest-label">对方月收入<text class="req">*</text></view>
          <picker mode="selector" range="{{incomeOptions}}" bindchange="onGuestFormPick" data-field="c_income">
            <view class="guest-picker {{!guestForm.cIncome ? 'placeholder' : ''}}">{{guestForm.cIncome || '请选择月收入要求'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">居住的要求<text class="req">*</text></view>
          <picker mode="selector" range="{{guestCities}}" bindchange="onGuestFormPick" data-field="c_location">
            <view class="guest-picker {{!guestForm.cLocation ? 'placeholder' : ''}}">{{guestForm.cLocation || '请选择居住城市要求'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">对方是否有房</view>
          <picker mode="selector" range="{{houseOptions}}" bindchange="onGuestFormPick" data-field="c_house">
            <view class="guest-picker {{!guestForm.cHouse ? 'placeholder' : ''}}">{{guestForm.cHouse || '不限, 可选填'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">对方学历要求</view>
          <picker mode="selector" range="{{eduOptions}}" bindchange="onGuestFormPick" data-field="c_edu">
            <view class="guest-picker {{!guestForm.cEdu ? 'placeholder' : ''}}">{{guestForm.cEdu || '不限, 可选填'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">对方婚姻状况</view>
          <picker mode="selector" range="{{marriageOptions}}" bindchange="onGuestFormPick" data-field="c_marriage">
            <view class="guest-picker {{!guestForm.cMarriage ? 'placeholder' : ''}}">{{guestForm.cMarriage || '不限, 可选填'}}</view>
          </picker>
        </view>
        <view class="guest-row">
          <view class="guest-label">对方户籍地要求</view>
          <picker mode="selector" range="{{regions}}" bindchange="onGuestFormPick" data-field="c_origin">
            <view class="guest-picker {{!guestForm.cOrigin ? 'placeholder' : ''}}">{{guestForm.cOrigin || '不限, 可选填'}}</view>
          </picker>
        </view>
        <button class="member-lock-btn" bindtap="submitGuestCriteria">下一步</button>
      </view>

      <!-- 缴费页: 微信支付年费 / 体验码开通 / 暂不缴费 -->
      <view class="member-lock-card" wx:if="{{previewGate && guestStep === 6}}">
        <view class="pay-price-row">
          <text class="pay-price-num">¥{{guestYearPrice}}</text>
          <text class="pay-price-unit">/ 年会员</text>
        </view>
        <view class="pay-priv">
          <text>· 每日申请联系 {{guestDailyQuota}} 次</text>
          <text>· 红娘一对一撮合, 优先推荐</text>
          <text>· 全年资料展示, 不限查阅</text>
        </view>
        <button class="member-lock-btn" bindtap="onGuestPay" disabled="{{guestPaying}}">
          <text class="ico">💬</text>
          <text>{{guestPaying ? '支付中...' : guestPayMode === 'mock' ? '模拟微信支付 ' + guestYearPrice + ' 元' : '微信支付 ' + guestYearPrice + ' 元'}}</text>
        </button>
        <view class="pay-divide"></view>
        <view class="guest-row">
          <view class="guest-label">有体验码? 直接开通</view>
          <view class="redeem-row-inline">
            <input class="guest-input" type="text" placeholder="输入体验码" value="{{guestRedeemCode}}" bindinput="onGuestRedeemInput" maxlength="32" />
            <button class="pay-redeem-btn" bindtap="onGuestRedeemPay" disabled="{{guestPaying}}">开通</button>
          </view>
        </view>
        <view class="member-lock-alt" bindtap="skipGuestPay">暂不缴费, 先看看相配的会员 ›</view>
      </view>

      <!-- 每日推荐 (游客态): 显著注册横幅 + 前 5 详细 + 剩余模糊 -->
      <block wx:if="{{!previewGate && previewLoaded}}">
        <!-- 注册会员横幅 (要明显) -->
        <view class="register-banner" wx:if="{{!isWelcomed}}" bindtap="goRegister">
          <view class="rb-main">
            <text class="rb-title">注册会员</text>
            <text class="rb-sub">注册并开通, 解锁全部严选资料 · 红娘撮合</text>
          </view>
          <text class="rb-go">立即注册 ›</text>
        </view>
        <view class="register-banner" wx:elif="{{resumeToStep}}" bindtap="goRegister">
          <view class="rb-main">
            <text class="rb-title">注册会员</text>
            <text class="rb-sub">完善资料并开通, 解锁全部严选资料</text>
          </view>
          <text class="rb-go">去注册 ›</text>
        </view>
        <view class="register-banner paid" wx:else bindtap="goRegister">
          <view class="rb-main">
            <text class="rb-title">开通会员</text>
            <text class="rb-sub">到店办理或联系红娘, 现场开通</text>
          </view>
          <text class="rb-go">去开通 ›</text>
        </view>

        <view class="preview-card {{index === 0 ? (resumeToStep || !isWelcomed ? 'after-resume' : 'first') : ''}}" wx:for="{{previewList}}" wx:key="user_id" bindtap="onPreviewCardTap">
          <view class="preview-top">
            <text class="preview-code">{{item.xy_code || '严选会员'}}</text>
            <text class="preview-lock">🔒 会员可联系</text>
          </view>
          <view class="preview-body">
            <image wx:if="{{item.photo}}" class="preview-avatar" src="{{item.photo}}" mode="aspectFill" />
            <view wx:else class="preview-avatar placeholder"><text>缘</text></view>
            <view class="preview-main">
              <view class="preview-line big">{{item.gender || ''}} · {{item.year}}年<text wx:if="{{item.ageNow}}"> ({{item.ageNow}}岁)</text></view>
              <view class="preview-line">📍 {{item.location || '山东'}}<text wx:if="{{item.origin}}"> · 籍贯{{item.origin}}</text></view>
              <view class="preview-line">{{item.edu || '学历未填'}}<text wx:if="{{item.height}}"> · {{item.height}}cm</text><text wx:if="{{item.marriage}}"> · {{item.marriage}}</text></view>
              <view class="preview-line">{{item.job || '职业未填'}}<text wx:if="{{item.income}}"> · 月收入{{item.income}}</text></view>
            </view>
          </view>
          <view class="preview-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
        </view>
        <view wx:if="{{!previewList.length}}" class="member-lock-card">
          <view class="member-lock-store">
            <text class="name">暂无匹配的会员资料</text>
          </view>
          <view class="member-lock-phone">可先到店登记, 红娘优先为你物色</view>
        </view>

        <!-- 剩余资料模糊处理: 吸引注册 -->
        <view class="blurred-card" wx:for="{{blurredList}}" wx:key="index" bindtap="goRegister">
          <view class="blurred-line">{{item.gender || '会员'}} · {{item.age_range}} · {{item.location}}</view>
          <view class="blurred-lock">🔒 开通会员可见全部资料</view>
        </view>

        <view class="member-lock-card tight" wx:if="{{myHomeStore && myHomeStore.phone}}">
          <view class="member-lock-store">
            <text class="pin">📍</text>
            <text class="name">{{myHomeStore.city}} · {{myHomeStore.name}}</text>
            <text class="badge">会员制</text>
          </view>
          <button class="member-lock-btn" bindtap="callHomeStore">
            <text class="ico">☎</text>
            <text>拨打门店电话 · 现场开通</text>
          </button>
          <button wx:if="{{myHomeStore.contact_qr}}" class="member-lock-btn ghost" bindtap="showStoreQr">
            <text>加红娘微信</text>
          </button>
          <view class="member-lock-phone">客服电话 <text class="num">{{myHomeStore.phone}}</text></view>
          <view class="member-lock-divide"></view>
          <view class="member-lock-alt" bindtap="goMembership">已是会员? 查看会员状态 ›</view>
        </view>
        <view class="member-lock-card tight" wx:else>
          <view class="member-lock-store">
            <text class="pin">📍</text>
            <text class="name">还未绑定服务门店</text>
          </view>
          <button class="member-lock-btn" bindtap="goStoreCities">
            <text>去附近门店开通</text>
          </button>
          <view class="member-lock-divide"></view>
          <view class="member-lock-alt" bindtap="goMembership">已是会员? 查看会员状态 ›</view>
        </view>
        <view class="member-lock-steps">
          <view class="step">
            <view class="no">1</view>
            <view class="txt">到店咨询</view>
          </view>
          <view class="arrow">›</view>
          <view class="step">
            <view class="no">2</view>
            <view class="txt">实名认证</view>
          </view>
          <view class="arrow">›</view>
          <view class="step">
            <view class="no">3</view>
            <view class="txt">开通会员</view>
          </view>
        </view>
      </block>
      <!-- 预览加载失败: 重试入口 -->
      <view class="member-lock-card tight" wx:if="{{previewError}}">
        <view class="member-lock-store">
          <text class="name">内容加载失败</text>
        </view>
        <button class="member-lock-btn" bindtap="retryPreview">
          <text>重新加载</text>
        </button>
      </view>
      <view class="qualify-links">
        <text bindtap="goQualifications">平台资质</text>
        <text bindtap="goAgreement">用户协议</text>
        <text bindtap="goPrivacy">隐私政策</text>
      </view>
      <view class="member-lock-foot">乾缘婚恋 · 真诚严选</view>
      <template is="icp-footer" />
    </view>

    <!-- 会员已开通但未完成首启引导: 先补基本资料, 不放行资料流 -->
    <view class="welcomed-gate" wx:if="{{apiReady && isMember && !isWelcomed}}">
      <view class="wg-card">
        <view class="wg-crown">✦</view>
        <view class="wg-title">先完善基本资料</view>
        <view class="wg-sub">
          <text>填写头像和昵称, 约1分钟</text>
          <text>完成后即可浏览严选会员资料</text>
        </view>
        <button class="wg-btn" bindtap="goWelcome">去完善基本资料</button>
      </view>
    </view>

    <scroll-view wx:if="{{!apiReady || (isMember && isWelcomed)}}" class="screen main-screen" scroll-y>
      <view class="hero-header">
        <view class="nav-row light">
          <view class="nav-placeholder"></view>
          <view class="nav-title">每日推荐</view>
          <view class="nav-placeholder"></view>
        </view>

        <view class="notice-card" wx:if="{{bannerVisible}}">
          <view class="brand-seal">
            <text>寻</text>
            <text>缘</text>
          </view>
          <view class="notice-copy">
            <view>您还未开启每日推荐通知</view>
            <text>开启后每日为您推送精准匹配</text>
          </view>
          <button class="gold-btn mini" bindtap="toggleNotify">{{notifyEnabled ? '已开启' : '去开启'}}</button>
        </view>
      </view>

      <!-- 会员到期提醒 (7 天内) -->
      <view class="renew-bar" wx:if="{{isMember && memberDaysLeft !== null}}" bindtap="goMembership">
        <text class="renew-txt">会员将于 {{memberDaysLeft === 0 ? '今天' : memberDaysLeft + ' 天后'}} 到期 ({{memberExpiresAt}})</text>
        <text class="renew-btn">续费 ›</text>
      </view>

      <view class="quick-grid">
        <view class="quick-tile warm" bindtap="openVisitors">
          <view class="quick-icon">看</view>
          <view>
            <view>查看过我的</view>
            <text>{{visitorTotal}} 人</text>
          </view>
        </view>
        <view class="quick-tile blue" bindtap="openFavorites">
          <view class="quick-icon">藏</view>
          <view>
            <view>我收藏的</view>
            <text>{{favoriteTotal}} 人</text>
          </view>
        </view>
      </view>

      <view class="quota-bar" wx:if="{{isMember && memberQuota}}">
        <text class="quota-tag">会员</text>
        <text>今日还可申请 {{memberQuota.remaining}}/{{memberQuota.limit}} 次</text>
        <text wx:if="{{memberQuota.balance > 0}}" class="quota-extra">· 余额 {{memberQuota.balance}} 次</text>
      </view>

      <view class="home-tabs">
        <view class="pill {{homeTab == 'today' ? 'active' : ''}}" bindtap="switchHomeTab" data-tab="today">今日推荐</view>
        <view class="pill with-badge {{homeTab == 'new' ? 'active' : ''}}" bindtap="switchHomeTab" data-tab="new">
          <text>看看新人</text>
          <text class="new-badge">新</text>
        </view>
        <view class="missed-link {{homeTab == 'missed' ? 'active' : ''}}" bindtap="switchHomeTab" data-tab="missed">
          <text class="heart-line">♡</text>
          <text>错过的人›</text>
        </view>
      </view>

      <view class="push-row" bindtap="toggleNotify">
        <view>
          <view>{{notifyEnabled ? '已开启每日推荐通知' : '未开启每日推荐通知'}}</view>
          <text>每日上午10点更新</text>
        </view>
        <view class="switch {{notifyEnabled ? 'on' : ''}}">
          <view></view>
        </view>
      </view>

      <view class="list-toolbar">
        <view class="list-toolbar-left">
          <text wx:if="{{loginFailed}}" class="list-toolbar-status">登录失败, 无法加载推荐</text>
          <text wx:elif="{{activeFilterCount > 0}}" class="list-toolbar-status">已筛选 {{activeFilterCount}} 项 · 命中 {{profiles.length}} 条</text>
          <text wx:else class="list-toolbar-status">为你推荐 {{profiles.length}} 条</text>
        </view>
        <view class="list-toolbar-right">
          <text wx:if="{{activeFilterCount > 0}}" class="list-toolbar-clear" bindtap="clearFilter">清除</text>
          <button class="list-toolbar-filter" bindtap="openFilter">
            <text class="filter-icon">⚙</text>
            <text>{{activeFilterCount > 0 ? '修改筛选' : '筛选'}}</text>
          </button>
        </view>
      </view>

      <view class="profile-list">
        <view wx:if="{{profiles.length === 0}}" class="list-empty">
          <block wx:if="{{loginFailed}}">
            <text>登录失败, 暂时无法加载真实资料。</text>
            <button class="list-retry-btn" bindtap="retryLaunch">重新加载</button>
          </block>
          <text wx:else>暂无可推荐的资料, 试试调整筛选条件</text>
        </view>
        <view class="empty-feed" wx:if="{{apiReady && isMember && !profiles.length}}">
          <view class="empty-feed-icon">缘</view>
          <block wx:if="{{activeFilterCount > 0}}">
            <view class="empty-feed-title">没有符合当前筛选的资料</view>
            <view class="empty-feed-sub">筛选了 {{activeFilterCount}} 项条件, 试着放宽一些</view>
            <button class="empty-feed-btn" bindtap="clearFilter">一键放宽, 恢复每日推荐</button>
          </block>
          <block wx:else>
            <view class="empty-feed-title">今日推荐已看完</view>
            <view class="empty-feed-sub">明天为你推荐新的有缘人, 也可去消息页看看谁关注了你</view>
          </block>
        </view>
        <view wx:for="{{profiles}}" wx:key="id" class="profile-card">
          <view class="profile-id-row">
            <text class="profile-id">用户编号 {{item.xy_code || item.id}}</text>
            <view class="verify-badge mini {{item.isVerified ? 'on' : ''}}">
              <text>✓</text>
              <text>{{item.isVerified ? '已认证' : '未认证'}}</text>
            </view>
          </view>
          <view class="profile-main">
            <view class="avatar tone-{{item.tone}}">{{item.glyph}}</view>
            <view class="profile-body">
              <view class="profile-title">{{item.gender}} · {{item.year}}年</view>
              <view class="info-grid">
                <view><text>居住</text><text>{{item.location}}</text></view>
                <view><text>户籍</text><text>{{item.origin}}</text></view>
                <view><text>学历</text><text>{{item.edu}}</text></view>
                <view><text>身高</text><text>{{item.height}}cm</text></view>
              </view>
            </view>
          </view>
          <view class="desc-box"><text>介绍：</text>{{item.desc}}</view>
          <view class="card-actions">
            <button class="btn primary" bindtap="openDetail" data-id="{{item.id}}">查看资料</button>
            <view class="card-star big {{item.starred ? 'on' : ''}}" catchtap="onCardStar" data-index="{{index}}">
              <text class="card-star-icon">{{item.starred ? '★' : '☆'}}</text>
              <text class="card-star-text">{{item.starred ? '已收藏' : '收藏'}}</text>
            </view>
          </view>
        </view>
      </view>

      <template is="icp-footer" />
    </scroll-view>
  </block>

  <block wx:if="{{screen == 'detail'}}">
    <view class="screen child-screen">
      <view class="solid-header flat">
        <view class="nav-row light">
          <button class="nav-link light" bindtap="backFromDetail">‹ 返回</button>
          <view class="nav-title">资料</view>
          <button class="nav-link light right" bindtap="goHome">首页</button>
        </view>
      </view>

      <scroll-view class="child-scroll with-bottom" scroll-y>
        <view class="detail-card top">
          <view class="detail-head">
            <view class="avatar big tone-{{selectedProfile.tone}}">{{selectedProfile.glyph}}</view>
            <view class="detail-main">
              <view class="mono">用户编号 {{selectedProfile.xy_code || selectedProfile.id}}</view>
              <view class="detail-stats">
                <text><text class="ico star">★</text>{{selectedProfile.likes}}</text>
                <text><text class="ico flame">♥</text>{{selectedProfile.hot}}</text>
              </view>
            </view>
            <view class="verify-badge big {{selectedProfile.isVerified ? 'on' : ''}}">
              <text class="verify-badge-check">✓</text>
              <text class="verify-badge-text">{{selectedProfile.isVerified ? '已认证' : '未认证'}}</text>
            </view>
          </view>
          <view class="detail-actions">
            <view class="star-action {{detailStarred ? 'on' : ''}}" bindtap="toggleDetailStar">
              <text>{{detailStarred ? '★' : '☆'}}</text>
              <text>收藏</text>
            </view>
            <view class="like-action {{detailLiked ? 'on' : ''}} {{detailMutual ? 'mutual' : ''}}" bindtap="toggleDetailAffinity">
              <text>{{detailLiked ? '❤' : '♡'}}</text>
              <text>{{detailMutual ? '互相好感' : (detailLiked ? '已示好' : '好感')}}</text>
            </view>
          </view>
        </view>

        <view class="section-card" wx:if="{{selectedProfile.photos.length > 0}}">
          <view class="card-head">
            <view><text class="head-icon">照</text>照片 (点击查看大图)</view>
          </view>
          <scroll-view class="detail-photos" scroll-x>
            <image
              wx:for="{{selectedProfile.photos}}"
              wx:key="*this"
              src="{{item}}"
              mode="aspectFill"
              class="detail-photo"
              bindtap="previewDetailPhoto"
              data-index="{{index}}"
            />
          </scroll-view>
        </view>

        <view class="section-card">
          <view class="detail-grid">
            <view><text>出生</text><text>{{selectedProfile.birthLabel || (selectedProfile.year + '年')}}</text></view>
            <view><text>性别</text><text>{{selectedProfile.gender}}</text></view>
            <view><text>民族</text><text>{{selectedProfile.ethnicity || '—'}}</text></view>
            <view><text>学历</text><text>{{selectedProfile.edu}}</text></view>
            <view><text>身高</text><text>{{selectedProfile.height}}cm</text></view>
            <view><text>体重</text><text>{{selectedProfile.weight ? selectedProfile.weight + 'kg' : '—'}}</text></view>
            <view><text>户籍</text><text>{{selectedProfile.origin}}</text></view>
            <view><text>居住</text><text>{{selectedProfile.location}}</text></view>
            <view><text>职业</text><text>{{selectedProfile.job}}</text></view>
            <view><text>单位性质</text><text>{{selectedProfile.employerType || '—'}}</text></view>
          </view>
        </view>

        <view class="section-title"><text></text>更多详情</view>
        <view class="section-card">
          <view class="detail-grid">
            <view><text>专业</text><text>{{selectedProfile.major || '—'}}</text></view>
            <view><text>兴趣爱好</text><text>{{selectedProfile.hobbies || '—'}}</text></view>
            <view><text>家乡</text><text>{{selectedProfile.hometown}}</text></view>
            <view><text>婚姻</text><text>{{selectedProfile.marriage}}</text></view>
            <view><text>月收入</text><text>{{selectedProfile.income}}</text></view>
            <view><text>身体状况</text><text>{{selectedProfile.healthStatus || '—'}}</text></view>
            <view><text>是否有社保</text><text>{{selectedProfile.hasSocialInsurance || '—'}}</text></view>
            <view><text>是否有房</text><text>{{selectedProfile.hasHouse}}</text></view>
            <view><text>是否有车</text><text>{{selectedProfile.hasCar || '—'}}</text></view>
            <view><text>房贷车贷</text><text>{{selectedProfile.houseCarLoan || '—'}}</text></view>
            <view><text>体型</text><text>{{selectedProfile.bodyType}}</text></view>
            <view><text>性格</text><text>{{selectedProfile.personalityType || '—'}}</text></view>
          </view>
          <view class="desc-box full">{{selectedProfile.desc}}</view>
        </view>

        <view class="section-title"><text></text>择偶要求</view>
        <view class="section-card">
          <view class="pref-row"><text>年份</text><text>{{selectedProfile.wants.year}}</text></view>
          <view class="pref-row"><text>月收入</text><text>{{selectedProfile.wants.income}}</text></view>
          <view class="pref-row"><text>身高</text><text>{{selectedProfile.wants.height}}</text></view>
          <view class="pref-row"><text>婚房</text><text>{{selectedProfile.wants.house}}</text></view>
          <view class="pref-row"><text>学历要求</text><text>{{selectedProfile.wants.edu}}</text></view>
          <view class="pref-row"><text>婚姻要求</text><text>{{selectedProfile.wants.marriage}}</text></view>
          <view class="pref-row"><text>户籍地要求</text><text>{{selectedProfile.wants.origin}}</text></view>
          <view class="pref-row"><text>居住地要求</text><text>{{selectedProfile.wants.location}}</text></view>
          <view class="pref-row" wx:if="{{selectedProfile.wantsNote}}"><text>补充说明</text><text class="pref-note">{{selectedProfile.wantsNote}}</text></view>
        </view>
      </scroll-view>

      <view class="detail-toast" wx:if="{{detailToast}}">
        <text>觉得合适请尽快查看，明天将无法看到对方资料</text>
        <text bindtap="hideDetailToast">×</text>
      </view>
      <view class="bottom-actions detail-bottom">
        <button class="home-small" bindtap="goHome">回首页</button>
        <button class="btn primary wide" bindtap="openContact" disabled="{{requestSubmitted}}">{{requestSubmitted ? '已申请, 等红娘联系' : '联系当地门店'}}</button>
      </view>
      <view class="report-row">
        <text bindtap="reportProfile">发现虚假资料或骚扰? 举报此人</text>
      </view>
      <view class="prev-next">
        <button bindtap="prevProfile">‹ 上一个</button>
        <button bindtap="nextProfile">下一个 ›</button>
      </view>
    </view>
  </block>

  <block wx:if="{{screen == 'my-profile'}}">
    <view class="screen child-screen">
      <view class="solid-header profile-header">
        <view class="nav-row light">
          <button class="nav-link light" bindtap="backToMe">‹ 返回</button>
          <view class="nav-title">资料</view>
          <view class="nav-placeholder"></view>
        </view>
        <view class="follow-card">
          <view class="warn-dot">!</view>
          <text>关注公众号，可及时接收意向提醒</text>
          <button class="gold-btn mini">立即关注</button>
        </view>
      </view>

      <scroll-view class="child-scroll" scroll-y>
        <view class="self-card">
          <view class="self-head">
            <view class="avatar big tone-ocean">乾</view>
            <view class="self-main">
              <view class="self-id">用户编号 {{myXyCode || '53652255'}}</view>
              <view class="stat-row">
                <view wx:for="{{stats}}" wx:key="label">
                  <view>{{item.value}}</view>
                  <text>{{item.label}}</text>
                </view>
              </view>
            </view>
          </view>
          <view class="feature-row">
            <view class="resource-flag">享更多资源</view>
            <view><view class="round-icon {{meVerified ? 'on' : ''}}">✦</view><text>线下门店认证</text><text>{{meVerified ? '已认证' : '未认证'}}</text></view>
            <view><view class="round-icon dot">⇡</view><text>优先推荐</text><text>未开启</text></view>
            <view><view class="round-icon ring" style="background: conic-gradient(#c93434 0 {{profileProgress}}%, #f0e1d6 {{profileProgress}}% 100%);"><text class="ring-inner">{{profileProgress}}%</text></view><text>资料完善度</text><text>{{profileProgress}}%</text></view>
          </view>
        </view>

        <view class="section-card list-card">
          <view class="card-head">
            <view><text class="head-icon">资</text>我的资料</view>
          </view>
          <view class="detail-grid self-grid">
            <view wx:for="{{myProfileRows}}" wx:key="label">
              <text>{{item.label}}</text>
              <text>{{item.value}}</text>
            </view>
          </view>
        </view>

        <view class="section-card list-card">
          <view class="card-head">
            <view><text class="head-icon">介</text>更多介绍</view>
            <button class="gold-btn mini" bindtap="openIntroEdit">编辑</button>
          </view>
          <view class="desc-box full warm-desc">{{profileDesc || '点右上角「编辑」补充自我介绍，让大家更了解你'}}</view>
        </view>

        <view class="section-card list-card" wx:if="{{myParentsRows.length > 0}}">
          <view class="card-head">
            <view><text class="head-icon">家</text>家庭成员情况</view>
          </view>
          <view class="detail-grid self-grid">
            <view wx:for="{{myParentsRows}}" wx:key="label">
              <text>{{item.label}}</text>
              <text>{{item.value}}</text>
            </view>
          </view>
        </view>

        <view class="section-card list-card">
          <view class="card-head">
            <view><text class="head-icon">择</text>择偶要求</view>
            <button class="btn outline" bindtap="openCriteriaEdit" data-return="my-profile">编辑</button>
          </view>
          <view class="pref-row"><text>年份</text><text>{{criteriaValues.year}}</text></view>
          <view class="pref-row"><text>身高</text><text>{{criteriaValues.height}}</text></view>
          <view class="pref-row"><text>月收入</text><text>{{criteriaValues.income}}</text></view>
          <view class="pref-row"><text>是否有房</text><text>{{criteriaValues.house}}</text></view>
          <view class="pref-row"><text>学历要求</text><text>{{criteriaValues.edu}}</text></view>
          <view class="pref-row"><text>婚姻要求</text><text>{{criteriaValues.marriage}}</text></view>
          <view class="pref-row"><text>户籍地要求</text><text>{{criteriaValues.origin}}</text></view>
          <view class="pref-row"><text>居住的要求</text><text>{{criteriaValues.location}}</text></view>
        </view>

        <view class="share-actions">
          <button class="btn outline" bindtap="openProfileEdit" data-return="my-profile">修改资料</button>
          <button class="btn primary" bindtap="shareProfile">分享到群或好友 ›</button>
        </view>
      </scroll-view>
    </view>
  </block>

  <block wx:if="{{screen == 'intro-edit'}}">
    <view class="screen child-screen">
      <view class="hero-header compact">
        <view class="nav-row light">
          <button class="nav-link light" bindtap="closeIntroEdit">‹ 返回</button>
          <view class="nav-title">更多介绍</view>
          <view class="nav-placeholder"></view>
        </view>
        <view class="edit-title">手动编辑</view>
      </view>

      <scroll-view class="child-scroll with-bottom" scroll-y>
        <view class="form-card padded">
          <view class="form-title">更多介绍</view>
          <textarea value="{{introDraft}}" bindinput="onIntroDraftInput" maxlength="240" placeholder="补充你的介绍：例如性格、爱好、家庭情况、生活习惯等。注意：此处不要留联系方式。"></textarea>
        </view>
      </scroll-view>

      <view class="bottom-actions">
        <button class="btn muted" bindtap="closeIntroEdit">取消</button>
        <button class="btn primary wide" bindtap="saveIntro">保存</button>
      </view>
    </view>
  </block>

  <block wx:if="{{screen == 'me'}}">
    <scroll-view class="screen main-screen" scroll-y>
      <view class="solid-header me-header">
        <view class="nav-row light">
          <view class="nav-placeholder"></view>
          <view class="nav-title">我的</view>
          <view class="nav-placeholder"></view>
        </view>
        <view class="me-profile">
          <image wx:if="{{myAvatar}}" class="avatar big me-avatar-img" src="{{myAvatar}}" mode="aspectFill" />
          <view wx:else class="avatar big tone-ocean">乾</view>
          <view>
            <view class="me-nick-row">
              <text class="me-nick">{{myNickname || '用户' + (myXyCode || '')}}</text>
              <text class="me-badge {{isMember ? 'on' : ''}}">{{isMember ? '✦ 会员' : '未开通会员'}}</text>
            </view>
            <text class="me-sub">编号 {{myXyCode || '—'}}{{isMember && memberExpiresAt ? ' · ' + memberExpiresAt + ' 到期' : ''}}</text>
          </view>
        </view>
      </view>

      <!-- 三格状态条: 完善度 / 今日剩余 / 会员状态 -->
      <view class="me-stats">
        <view class="me-stat">
          <view>{{profileProgress}}%</view>
          <text>资料完善度</text>
        </view>
        <view class="me-stat">
          <view>{{memberQuota ? memberQuota.remaining : '—'}}</view>
          <text>今日可申请</text>
        </view>
        <view class="me-stat">
          <view>{{isMember ? '生效中' : '—'}}</view>
          <text>会员状态</text>
        </view>
      </view>
      <view class="action-list">
        <view wx:for="{{meItems}}" wx:key="label" class="action-row" bindtap="tapMeItem" data-label="{{item.label}}">
          <view class="action-icon">{{item.icon}}</view>
          <view>
            <view>{{item.label}}</view>
            <text wx:if="{{item.sub}}">{{item.sub}}</text>
          </view>
          <text>›</text>
        </view>
      </view>
      <template is="icp-footer" />
    </scroll-view>
  </block>

  <block wx:if="{{screen == 'visitors'}}">
    <view class="screen child-screen">
      <view class="solid-header flat">
        <view class="nav-row light">
          <button class="nav-link light" bindtap="backToMe">‹ 返回</button>
          <view class="nav-title">看过我的人</view>
          <view class="nav-placeholder"></view>
        </view>
      </view>
      <scroll-view class="child-scroll" scroll-y>
        <view class="list-empty" wx:if="{{visitorTotal == 0}}">
          <text>暂时还没有人看过你的资料</text>
        </view>
