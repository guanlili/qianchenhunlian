.request-target {
  font-family: monospace;
  font-size: 26rpx;
  color: #1f1a17;
  font-weight: 700;
}
.request-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 24rpx;
  font-weight: 600;
}
.status-pending { background: #fff5e6; color: #b8731f; }
.status-good    { background: #eaf4ec; color: #2d8c4d; }
.status-bad     { background: #f9e0e0; color: #c93434; }
.status-muted   { background: #efe4d2; color: #5a4f47; }
.request-msg, .request-note {
  font-size: 25rpx;
  color: #5a4f47;
  line-height: 1.5;
  margin-top: 6rpx;
}
.request-msg text, .request-note text { color: #9a8e84; }
.request-time {
  display: block;
  font-size: 22rpx;
  color: #b0a698;
  margin-top: 10rpx;
}

.list-empty {
  padding: 80rpx 32rpx;
  color: #9a8e84;
  font-size: 26rpx;
  text-align: center;
}

.visitor-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f0e1d6;
  background: #fff;
}

.visitor-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f9e5e0;
  color: #c93434;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  flex-shrink: 0;
}

.visitor-img {
  width: 100%;
  height: 100%;
}

.visitor-info {
  flex: 1;
  min-width: 0;
}

.visitor-title {
  color: #1f1a17;
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.visitor-time {
  color: #9a8e84;
  font-size: 22rpx;
}

.visitor-arrow {
  color: #c0b0a0;
  font-size: 36rpx;
}

.list-toolbar {
  margin: 18rpx 28rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.list-toolbar-status {
  color: #5a4f47;
  font-size: 26rpx;
  font-weight: 600;
}

.list-toolbar-right {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.list-toolbar-clear {
  color: #c93434;
  font-size: 24rpx;
  font-weight: 700;
}

.list-toolbar-filter {
  background: #f7efe3;
  color: #c93434;
  border-radius: 24rpx;
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6rpx;
  line-height: 1.6;
}
.list-toolbar-filter::after {
  border: none;
}
.filter-icon {
  font-size: 26rpx;
}

.unlock-tag {
  flex: 1;
  padding: 18rpx 24rpx;
  background: #eaf4ec;
  color: #2d8c4d;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #efe4d2;
}

.contact-row:first-of-type {
  margin-top: 12rpx;
}

.contact-label {
  width: 110rpx;
  color: #9a8e84;
  font-size: 24rpx;
}

.contact-value {
  flex: 1;
  font-family: 'PingFang SC', monospace;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1a17;
  word-break: break-all;
}

.contact-copy-btn {
  flex-shrink: 0;
  background: #c93434;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}

.contact-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f1a17;
  padding: 8rpx 0;
}

.contact-tip {
  display: block;
  margin-top: 12rpx;
  color: #b0a89e;
  font-size: 22rpx;
  line-height: 1.6;
}
.contact-copy-btn::after {
  border: none;
}

.sheet-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  max-height: 650rpx;
  overflow: auto;
}

.sheet-option {
  min-height: 76rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #f7efe3;
  color: #1f1a17;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.sheet-option.selected {
  background: #c93434;
  color: #ffffff;
}

.my-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 16rpx;
}

.my-photo-img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  background: #f7efe3;
}

.like-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 22rpx;
  border-radius: 14rpx;
  background: #f7efe3;
  color: #9a8e84;
}

.like-action.on {
  background: #f9e5e0;
  color: #c93434;
}

.like-action.mutual {
  background: linear-gradient(135deg, #ff6b6b 0%, #c93434 100%);
  color: #fff;
}

.like-action text:first-child {
  font-size: 28rpx;
  line-height: 1;
}
.like-action text:last-child {
  font-size: 22rpx;
  line-height: 1;
}

.affinity-shortcuts {
  margin-top: 16rpx;
}
.affinity-section-title {
  margin: 28rpx 32rpx 4rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1a17;
}
.affinity-tip {
  margin: 16rpx 28rpx 28rpx; padding: 18rpx 22rpx;
  background: #fff7eb; border-radius: 12rpx;
  color: #b07a1a; font-size: 22rpx;
}
.affinity-row .visitor-avatar {
  background: linear-gradient(135deg, #ffb3b3 0%, #c93434 100%);
  color: #fff;
}

.home-footer {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* --- 门店会员制锁屏 (非会员首页) --- */
/* --- 会员锁屏 (系统重设计 v3: 深红头部 + 白卡片 + 红渐变主按钮 + 三步引导) --- */
.member-lock {
  min-height: 100vh;
  background: linear-gradient(165deg, #a01f1f 0%, #8f1f1f 36%, #fbf6ee 36.4%, #fbf6ee 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 52rpx 56rpx;
  box-sizing: border-box;
}

.member-lock-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 皇冠光晕: 金色径向渐变垫在图标后 */
.member-lock-crown-wrap {
  position: relative;
  margin-bottom: 24rpx;
}

.member-lock-crown-wrap::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 380rpx;
  height: 380rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(246, 198, 107, 0.38) 0%, rgba(246, 198, 107, 0) 68%);
  pointer-events: none;
}

.member-lock-crown {
  width: 156rpx;
  height: 156rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, #f6c66b, #ed7030);
  border: 5rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 20rpx 52rpx rgba(237, 112, 48, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  font-weight: 800;
  color: #ffffff;
}

.member-lock-title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.member-lock-sub {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  line-height: 1.7;
}

/* 白色信息卡片: 门店 + 主按钮 + 电话 + 次级链接 */
.member-lock-card {
  margin-top: 88rpx;
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 32rpx 80rpx rgba(98, 21, 21, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.member-lock-store {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.member-lock-store .pin {
  font-size: 28rpx;
  line-height: 1;
  transform: translateY(2rpx);
}

.member-lock-store .name {
  font-size: 31rpx;
  font-weight: 800;
  color: #1f1a17;
}

.member-lock-store .badge {
  margin-left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(246, 198, 107, 0.22);
  color: #a1651c;
  font-size: 21rpx;
  font-weight: 700;
}

/* 主按钮: 与会员页「去附近门店」同款——浅粉底 + 品牌红字 + 胶囊, 无阴影 */
.member-lock-btn {
  margin-top: 32rpx;
  width: 100%;
  min-height: 92rpx;
  border-radius: 999rpx;
  background: #f9e5e0;
  color: #c93434;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
}

.member-lock-btn .ico {
  font-size: 28rpx;
}

.member-lock-btn::after {
  border: none;
}

.member-lock-btn:active {
  opacity: 0.85;
}

.member-lock-phone {
  margin-top: 24rpx;
  color: #8d8175;
  font-size: 25rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 号码深灰降权: 主按钮是卡片内唯一红字焦点 */
.member-lock-phone .num {
  color: #1f1a17;
  font-weight: 700;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

.member-lock-divide {
  width: 100%;
  height: 1rpx;
  background: #f0e8dd;
  margin: 28rpx 0 24rpx;
}

/* 次级链接: 弱化为暖灰, 不与主按钮抢焦点 */
.member-lock-alt {
  color: #93826d;
  font-size: 25rpx;
  font-weight: 500;
}

/* 三步开通引导: 填充下半屏留白, 强化转化路径 */
.member-lock-steps {
  margin-top: 60rpx;
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 44rpx rgba(98, 21, 21, 0.06);
  display: flex;
  align-items: flex-start;
}

.member-lock-steps .step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.member-lock-steps .no {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fdf3e0;
  color: #c93434;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-lock-steps .txt {
  font-size: 24rpx;
  font-weight: 600;
  color: #8d8175;
}

.member-lock-steps .arrow {
  height: 68rpx;
  display: flex;
  align-items: center;
  color: #d9c9b4;
  font-size: 26rpx;
  padding: 0 4rpx;
}

.member-lock-card.tight {
  margin-top: 40rpx;
}

/* --- 游客三问表单 (性别/出生年份/城市) --- */
.guest-row {
  width: 100%;
  margin-bottom: 26rpx;
  display: flex;
  flex-direction: column;
}

.guest-row:last-of-type {
  margin-bottom: 0;
}

.guest-label {
  color: #5a4f47;
  font-size: 26rpx;
  margin-bottom: 14rpx;
  font-weight: 600;
  text-align: left;
}

.req {
  color: #c93434;
  margin-left: 4rpx;
}

.gender-chips {
  display: flex;
  gap: 20rpx;
}

.gender-chip {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e3d6bf;
  border-radius: 999rpx;
  background: #fbf7ee;
  color: #5a4f47;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.gender-chip.on {
  border-color: #c93434;
  background: #f9e5e0;
  color: #c93434;
}

.guest-picker {
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e3d6bf;
  border-radius: 12rpx;
  background: #fbf7ee;
  font-size: 28rpx;
  color: #1f1a17;
  display: flex;
  align-items: center;
}

.guest-picker.placeholder {
  color: #b3a89a;
}

.guest-retry {
  margin-top: 10rpx;
  color: #c93434;
  font-size: 23rpx;
  text-align: left;
}

.guest-input {
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e3d6bf;
  border-radius: 12rpx;
  background: #fbf7ee;
  font-size: 28rpx;
  color: #1f1a17;
  box-sizing: border-box;
}

/* 缴费页 */
.pay-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.pay-price-num {
  color: #c93434;
  font-size: 64rpx;
  font-weight: 800;
}

.pay-price-unit {
  color: #8d8175;
  font-size: 26rpx;
}

.pay-priv {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: #fdf7ef;
  border: 1rpx solid #f0e1d6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.pay-priv text {
  color: #8d8175;
  font-size: 23rpx;
  text-align: left;
}

.pay-divide {
  width: 100%;
  height: 1rpx;
  background: #f0e8dd;
  margin: 28rpx 0 24rpx;
}

.redeem-row-inline {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.redeem-row-inline .guest-input {
  flex: 1;
}

.pay-redeem-btn {
  flex-shrink: 0;
  width: 160rpx;
  min-height: 84rpx;
  border: none;
  border-radius: 999rpx;
  background: #f9e5e0;
  color: #c93434;
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-redeem-btn[disabled] {
  opacity: 0.6;
  background: #f9e5e0;
  color: #c93434;
}

/* 向导第 4 步: 头像 / 协议 */
.guest-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  align-self: center;
}

.guest-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #c93434;
}

.guest-avatar-default {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f7d6cf 0%, #c93434 100%);
  color: #ffffff;
  font-size: 72rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-avatar-tag {
  font-size: 22rpx;
  color: #9a8e84;
}

.guest-agree {
  width: 100%;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.guest-checkbox {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c93434;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-checkbox.on {
  background: #c93434;
}

.guest-agree-text {
  font-size: 23rpx;
  color: #8d8175;
  line-height: 1.5;
}

.guest-agree-text .link {
  color: #c93434;
}

.guest-textarea {
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e3d6bf;
  border-radius: 12rpx;
  background: #fbf7ee;
  font-size: 26rpx;
  color: #1f1a17;
  width: 100%;
  box-sizing: border-box;
  line-height: 1.6;
}

.member-lock-card .guest-row .member-lock-btn,
.member-lock-card > .member-lock-btn {
  margin-top: 32rpx;
}

/* --- 预览资料卡 (游客可见, 点击引导开通) --- */
.preview-card {
  width: 100%;
  margin-top: 32rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 30rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 44rpx rgba(98, 21, 21, 0.08);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.preview-card.first {
  margin-top: 88rpx;
}

/* 注册会员横幅 (推荐页显著入口) */
.register-banner {
  width: 100%;
  margin-top: 88rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #f6c66b 0%, #ed7030 100%);
  box-shadow: 0 20rpx 48rpx rgba(237, 112, 48, 0.4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.register-banner.paid {
  background: linear-gradient(135deg, #d9534f 0%, #a01f1f 100%);
  box-shadow: 0 20rpx 48rpx rgba(160, 31, 31, 0.4);
}

.rb-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: flex-start;
}

.rb-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.rb-sub {
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
}

.rb-go {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* 模糊卡: 剩余资料只给性别/年龄段/城市 */
.blurred-card {
  width: 100%;
  margin-top: 24rpx;
  padding: 26rpx 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx dashed #d9c9b4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.blurred-line {
  color: #93826d;
  font-size: 27rpx;
  font-weight: 600;
}

.blurred-lock {
  color: #a89c8d;
  font-size: 21rpx;
}

/* 资质与协议入口行 */
.qualify-links {
  margin-top: 40rpx;
  display: flex;
  gap: 40rpx;
}

.qualify-links text {
  color: #a89c8d;
  font-size: 23rpx;
  text-decoration: underline;
}

/* 幽灵按钮 (加红娘微信, 弱于主按钮) */
.member-lock-btn.ghost {
  margin-top: 20rpx;
  background: transparent;
  border: 2rpx solid rgba(201, 52, 52, 0.45);
  color: #c93434;
  min-height: 80rpx;
}

.preview-card.after-resume {
  margin-top: 40rpx;
}

/* 续填入口条 */
.resume-bar {
  width: 100%;
  margin-top: 88rpx;
  padding: 22rpx 28rpx;
  background: rgba(246, 198, 107, 0.16);
  border: 1rpx solid rgba(246, 198, 107, 0.5);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.resume-txt {
  color: #a1651c;
  font-size: 25rpx;
  font-weight: 600;
}

.resume-go {
  color: #c93434;
  font-size: 25rpx;
  font-weight: 700;
}

.preview-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-code {
  color: #b3a89a;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.preview-lock {
  color: #a1651c;
  background: rgba(246, 198, 107, 0.22);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.preview-body {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.preview-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2rpx solid #f0e1d6;
}

.preview-avatar.placeholder {
  background: linear-gradient(135deg, #f7d6cf 0%, #c93434 100%);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.preview-line {
  color: #5a4f47;
  font-size: 26rpx;
  text-align: left;
}

.preview-line.big {
  color: #1f1a17;
  font-size: 32rpx;
  font-weight: 800;
}

.preview-desc {
  color: #8d8175;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: left;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.member-lock-foot {
  margin-top: auto;
  padding-top: 48rpx;
  color: #a89c8d;
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

/* --- 引导中间态: 会员已开通但未完成首启引导, 先补基本资料 --- */
.welcomed-gate {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 52rpx;
  box-sizing: border-box;
}

.wg-card {
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 64rpx 44rpx 56rpx;
  box-sizing: border-box;
  box-shadow: 0 32rpx 80rpx rgba(98, 21, 21, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wg-crown {
  width: 140rpx;
  height: 140rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #f6c66b, #ed7030);
  box-shadow: 0 20rpx 44rpx rgba(237, 112, 48, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 36rpx;
}

.wg-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f1a17;
}

.wg-sub {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 25rpx;
  color: #8d8175;
  line-height: 1.7;
}

/* 与「去附近门店」同款浅粉胶囊 */
.wg-btn {
  margin-top: 48rpx;
  width: 100%;
  min-height: 92rpx;
  border-radius: 999rpx;
  background: #f9e5e0;
  color: #c93434;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wg-btn::after {
  border: none;
}

.wg-btn:active {
  opacity: 0.85;
}

/* --- 会员权益可视化 --- */
.quota-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 28rpx 20rpx;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  background: #fdf3e0;
  border: 1rpx solid #f0d9ae;
  color: #a1651c;
  font-size: 24rpx;
}

.quota-bar.sheet {
  margin: 0 0 16rpx;
}

.quota-tag {
  background: linear-gradient(90deg, #f4a23a, #ed7030);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.quota-extra {
  color: #b3a89a;
}

/* --- 资料完善差距提示 --- */
.gap-card {
  margin: 20rpx 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fdf3e0;
  border: 1rpx solid #f0d9ae;
}

.gap-title {
  color: #a1651c;
  font-size: 28rpx;
  font-weight: 700;
}

.gap-sub {
  color: #8d8175;
  font-size: 23rpx;
  margin-top: 8rpx;
}

.gap-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.gap-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e8d5b5;
  color: #a1651c;
  font-size: 23rpx;
}

/* --- 推荐空态引导 --- */
.empty-feed {
  margin: 40rpx 28rpx;
  padding: 70rpx 40rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(98, 21, 21, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-feed-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #f9e5e0;
  color: #c93434;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
  margin-bottom: 26rpx;
}

.empty-feed-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1a17;
}

.empty-feed-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8d8175;
}

/* 与「去附近门店」按钮同款: 浅粉胶囊, 全局统一 CTA 语言 */
.empty-feed-btn {
  margin-top: 36rpx;
  width: 460rpx;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #f9e5e0;
  color: #c93434;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-feed-btn::after {
  border: none;
}

.empty-feed-btn:active {
  opacity: 0.85;
}

.pref-note {
  text-align: right;
}

/* --- 我的页改版 --- */
.me-avatar-img {
  background: #f0e8dd;
}

.me-nick-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.me-nick {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.me-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.75);
  font-size: 21rpx;
  font-weight: 700;
}

.me-badge.on {
  background: linear-gradient(90deg, #f6c66b, #ed7030);
  color: #ffffff;
}

.me-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.me-stats {
  display: flex;
  margin: -24rpx 28rpx 0;
  padding: 26rpx 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(98, 21, 21, 0.1);
  position: relative;
  z-index: 2;
}

.me-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.me-stat + .me-stat {
  border-left: 1rpx solid #f0e8dd;
}

.me-stat view {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f1a17;
}

.me-stat text {
  font-size: 21rpx;
  color: #8d8175;
}

/* 详情页举报入口 */
.report-row {
  text-align: center;
  padding: 10rpx 0 6rpx;
}

.report-row text {
  color: #b3a89a;
  font-size: 23rpx;
  text-decoration: underline;
}

/* --- 详情页照片横滑区 --- */
.detail-photos {
  white-space: nowrap;
  padding: 0 28rpx 24rpx;
}

.detail-photo {
  display: inline-block;
  width: 220rpx;
  height: 280rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
  background: #f0e8dd;
}

/* --- 消息页非会员锁 --- */
.affinity-lock {
  margin: 40rpx 28rpx;
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(98, 21, 21, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 图标与锁屏皇冠同语言: 金橙渐变圆角方 + 白色符号 */
.affinity-lock-crown {
  width: 100rpx;
  height: 100rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #f6c66b, #ed7030);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(237, 112, 48, 0.35);
}

.affinity-lock-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #1f1a17;
}

.affinity-lock-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8d8175;
  text-align: center;
  line-height: 1.6;
}

/* 与「去附近门店」按钮同款: 浅粉胶囊 CTA */
.affinity-lock-btn {
  margin-top: 36rpx;
  width: 100%;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #f9e5e0;
  color: #c93434;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.affinity-lock-btn::after {
  border: none;
}

.affinity-lock-btn:active {
  opacity: 0.85;
}
